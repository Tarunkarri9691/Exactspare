# EXACTSPARE Backend Environment Variables

# Application Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (e.g., mongodb://localhost:27017/exactspare or mongodb+srv://<user>:<password>@cluster.mongodb.net/exactspare)
MONGODB_URI=mongodb://127.0.0.1:27017/exactspare

# Frontend Application Origin for CORS configuration
FRONTEND_URL=http://localhost:5173

# Authentication & JWT Configuration
JWT_SECRET=exactspare_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Initial Admin CLI Setup Configuration (for scripts/initAdmin.js)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@exactspare.com
ADMIN_PHONE=+919876543210
ADMIN_PASSWORD=AdminExactSpare@2026

# Payment Gateway Configuration (Module 6 - Optional Online Payment Integration)
# Set to 'true' once live credentials are provided; Cash on Delivery (COD) is enabled by default
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
