# ==============================================================================
# EXACTSPARE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the server.
# NEVER commit real production credentials or .env files to Git repositories.
# ==============================================================================

# Application Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local MongoDB: mongodb://127.0.0.1:27017/exactspare
# MongoDB Atlas: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/exactspare?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/exactspare

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# In production, generate a cryptographically strong 64-character random string:
# Run in PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=replace_with_a_secure_random_64_char_key_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS & FRONTEND CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Frontend origin permitted to make credentialed requests to this API:
# Local Development: http://localhost:5173
# Production Example: https://exactspare.example.com
FRONTEND_URL=http://localhost:5173

# Optional: Shared cookie domain for cross-subdomain deployments (e.g. .example.com)
# Leave blank when frontend and backend are on separate top-level domains or localhost
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# INITIAL ADMINISTRATOR SEED CREDENTIALS (for scripts/initAdmin.js)
# ------------------------------------------------------------------------------
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@exactspare.com
ADMIN_PHONE=+919876543210
ADMIN_PASSWORD=AdminExactSpare@2026

# ------------------------------------------------------------------------------
# OPTIONAL PAYMENT GATEWAY (Cash on Delivery enabled by default)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
