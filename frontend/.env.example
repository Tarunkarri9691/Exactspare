# ==============================================================================
# EXACTSPARE FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before running Vite if you need custom API URLs.
# Note: Variables prefixed with VITE_ are bundled into client code and visible in the browser.
# NEVER place private database credentials, payment secrets, or server keys here.
# ==============================================================================

# Backend API Base URL
# Local Development default: http://localhost:5000/api
# Production Deployment Example: https://api.exactspare.example.com/api
VITE_API_BASE_URL=http://localhost:5000/api
