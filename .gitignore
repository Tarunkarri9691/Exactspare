# ==============================================================================
# EXACTSPARE ROOT .GITIGNORE
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment variables & secrets (CRITICAL: NEVER COMMIT REAL SECRETS)
.env
*.env
.env.*
*/.env
*/.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!**/.env.example

# SSL Certificates, Private Keys & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Build outputs
dist/
*/dist/
build/
*/build/
*.tsbuildinfo

# Logs & runtime data
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/
*.pid
*.seed

# Test coverage
coverage/
*/coverage/
.nyc_output/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Uploaded media (local storage)
backend/uploads/shops/*
!backend/uploads/shops/.gitkeep
backend/uploads/parts/*
!backend/uploads/parts/.gitkeep
backend/uploads/documents/*
!backend/uploads/documents/.gitkeep
backend/uploads/temp/*
!backend/uploads/temp/.gitkeep

# Local user database
backend/data/

# Temporary and cache directories
.cache/
.parcel-cache/
.eslintcache
